/* Decimal numbers/float */
----------------------------------------------------------------------------------------------------------------------
#Automatic type recognition for signed and unsigned float/decimal numbers
decimalNumber = 4.58                    #Immutable(Constant) signed 64bits Float Value
~decimalNumber = 4.58                   #Mutable(Variable/changeable) signed 64bits Float Value

# Explicit type assigment
decimalNumber: float = 4.58             #Immutable(Constant) type assigment to float
~decimalNumber: float = 4.58            #Mutable(Variable/changeable) type assigment to float

# Explicit immutable type and bits assigment
decimalNumber: float32 = 4.58           #Immutable(Constant) 32bits Float Value
decimalNumber: float64 = 4.58           #Immutable(Constant) 64bits Float Value

# Explicit mutable type and bits assigment
~decimalNumber: float32 = 4.58          #Mutable(Variable/changeable) 32bits Float Value
~decimalNumber: float64 = 4.58          #Mutable(Variable/changeable) 64bits Float Value
----------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------

/* Words/Strings */
----------------------------------------------------------------------------------------------------------------------
#Automatic type recognition for signed and unsigned strings
word = "Bob"                            #Immutable(Constant) 64bits String
~word = "Bob"                           #Mutable(Variable/changeable) 64bits String

# Explicit type assigment
word: str = "Bob"                       #Immutable(Constant) 64bits type assigment to string
~word: str = "Bob"                      #Mutable(Variable/changeable) 64bits type assigment to string

# Explicit immutable type size assigment
word: str32 = "Bob"                     #Immutable(Constant) 32bits String
word: str64 = "Bob"                     #Immutable(Constant) 64bits String

# Explicit mutable type size assigment
~word: str32 = "Bob"                    #Mutable(Variable/changeable) 32bits String
~word: str64 = "Bob"                    #Mutable(Variable/changeable) 64bits String

