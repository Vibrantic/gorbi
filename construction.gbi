/* Check statement boolean */
----------------------------------------------------------------------------------------------------------------------
stateCheck1 = true or false             #Immutable(Constant) 8bits Boolean
~stateCheck1 = true or false            #Mutable(Variable) 8bits Boolean

# Explicit type assigment
stateCheck1: bool = true or false       #Immutable(Constant) type assigment to boolean
~stateCheck1: bool = true or false      #Mutable(Variable/changeable) type assigment to boolean

# Explicit immutable type assigment
stateCheck1: bool8 = true or false      #Immutable(Constant) 8bits Boolean
stateCheck1: bool16 = true or false     #Immutable(Constant) 16bits Boolean
stateCheck1: bool32 = true or false     #Immutable(Constant) 32bits Boolean
stateCheck1: bool64 = true or false     #Immutable(Constant) 64bits Boolean

# Explicit mutable type assigment
~stateCheck1: bool8 = true or false     #Mutable(Variable/changeable) 8bits Boolean
~stateCheck1: bool16 = true or false    #Mutable(Variable/changeable) 16bits Boolean
~stateCheck1: bool32 = true or false    #Mutable(Variable/changeable) 32bits Boolean
~stateCheck1: bool64 = true or false    #Mutable(Variable/changeable) 64bits Boolean
