
/* Whole numbers/integers */
----------------------------------------------------------------------------------------------------------------------
#Automatic recognition
wholeNumber = 32                        #Immutable(Constant) automatically signed and automatic 64bits type assigment to Integer
~wholeNumber = 32                       #Mutable(Variable/changeable) automatically signed and automatic 64bits type assigment to Integer

# Explicit signed/unsigned and type definition but automatic bits assigment
wholeNumber: sint = 32                  #Immutable(Constant) signed 64bits Integer Value
~wholeNumber: sint = 32                 #Mutable(Variable/changeable) signed 64bits Integer Value
wholeNumber: uint = 32                  #Immutable(Constant) unsigned 64bits Integer Value
~wholeNumber: uint = 32                 #Mutable(Variable/changeable) unsigned 64bits Integer Value

# Explicit type assigment and automatic bits recognition
wholeNumber: int = 32                   #Immutable(Constant) automatically signed and explicit type assigment to integer
~wholeNumber: int = 32                  #Mutable(Variable/changeable) automatically signed and explicit type assigment to integer

# Explicit immutable signed type assigment
wholeNumber: sint1 = 1                  #Immutable(Constant) signed 1bit Integer Value
wholeNumber: sint4 = 32                 #Immutable(Constant) signed 4bits Integer Value
wholeNumber: sint8 = 32                 #Immutable(Constant) signed 8bits Integer Value
wholeNumber: sint16 = 32                #Immutable(Constant) signed 16bits Integer Value
wholeNumber: sint32 = 32                #Immutable(Constant) signed 32bits Integer Value
wholeNumber: sint64 = 32                #Immutable(Constant) signed 64bits Integer Value

# Explicit mutable signed type assigment
~wholeNumber: sint1 = 1                 #Mutable(Variable/changeable) signed 1bit Integer Value
~wholeNumber: sint4 = 32                #Mutable(Variable/changeable) signed 4bits Integer Value
~wholeNumber: sint8 = 32                #Mutable(Variable/changeable) signed 8bits Integer Value
~wholeNumber: sint16 = 32               #Mutable(Variable/changeable) signed 16bits Integer Value
~wholeNumber: sint32 = 32               #Mutable(Variable/changeable) signed 32bits Integer Value
~wholeNumber: sint64 = 32               #Mutable(Variable/changeable) signed 64bits Integer Value

# Explicit immutable unsigned type assigment
wholeNumber: uint1 = 1                  #Immutable(Constant) unsigned 1bit Integer Value
wholeNumber: uint4 = 32                 #Immutable(Constant) unsigned 4bits Integer Value
wholeNumber: uint8 = 32                 #Immutable(Constant) unsigned 8bits Integer Value
wholeNumber: uint6 = 32                 #Immutable(Constant) unsigned 16bits Integer Value
wholeNumber: uint32 = 32                #Immutable(Constant) unsigned 32bits Integer Value
wholeNumber: uint4 = 32                 #Immutable(Constant) unsigned 64bits Integer Value

# Explicit mutable unsigned type assigment
~wholeNumber: uint1 = 1                 #Mutable(Variable/changeable) unsigned 1bit Integer Value
~wholeNumber: uint4 = 32                #Mutable(Variable/changeable) unsigned 4bits Integer Value
~wholeNumber: uint8 = 32                #Mutable(Variable/changeable) unsigned 8bits Integer Value
~wholeNumber: uint16 = 32               #Mutable(Variable/changeable) unsigned 16bits Integer Value
~wholeNumber: uint32 = 32               #Mutable(Variable/changeable) unsigned 32bits Integer Value
~wholeNumber: uint64 = 32               #Mutable(Variable/changeable) unsigned 64bits Integer Value
