/* Array */
----------------------------------------------------------------------------------------------------------------------
numbers: array<i32>
----------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------


a: i32 = 2
b: i32 = 5
~c: i32

# Function Construction
fn calculate(a: i32, b: i32) -> i32?
    ~c = a + b

    # Check statement Action-Driven
    when =
        ~c == y -> fn(arg)
    then
        ~c == x -> fn(arg)

    # Check statement Value-Driven
    ~c = when
        x > y -> fn(arg)

    loop 10
        ~c++

    loop ~c in list()
        ~c++